---
permalink: /feed-ttrpg.xml
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>@redforroseline Blog - TTRPG</title>
    <link>{{ metadata.url }}</link>
    <description>TTRPG blog posts</description>
    <language>en-us</language>
    <atom:link href="{{ metadata.url }}/feed-ttrpg.xml" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ build.timestamp | rssDate }}</lastBuildDate>
    {% for post in collections.ttrpgPostsReversed %}
      <item>
        <title>{{ post.data.title }}</title>
        <link>{{ metadata.url }}{{ post.url }}</link>
        <description>{{ post.data.description }}</description>
        <pubDate>{{ post.date | rssDate }}</pubDate>
        <guid>{{ metadata.url }}{{ post.url }}</guid>
      </item>
    {% endfor %}
  </channel>
</rss>
