---
permalink: /rss.xml
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ metadata.title }}</title>
    <link>{{ metadata.url }}</link>
    <description>Personal blog covering anime, games, and more</description>
    <language>en-us</language>
    <atom:link href="{{ metadata.url }}/rss.xml" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ build.timestamp | dateToRfc822 }}</lastBuildDate>
    {% for post in collections.postsReversed %}
      <item>
        <title>{{ post.data.title }}</title>
        <link>{{ metadata.url }}{{ post.url }}</link>
        <description>{{ post.data.description }}</description>
        <content:encoded><![CDATA[{{ post.templateContent | htmlToAbsoluteUrls(metadata.url) | safe }}]]></content:encoded>
        <pubDate>{{ post.date | dateToRfc822 }}</pubDate>
        <guid>{{ metadata.url }}{{ post.url }}</guid>
      </item>
    {% endfor %}
  </channel>
</rss>